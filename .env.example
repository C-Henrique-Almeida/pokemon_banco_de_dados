# ==========================================
# Configuração do banco de dados PostgreSQL
# ==========================================
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pokedex

# Alternativa: em vez das variáveis acima, você pode usar uma única
# string de conexão. Se DATABASE_URL estiver preenchida, ela tem prioridade.
# Útil para serviços em nuvem (Neon, Supabase, Railway, Render...).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/pokedex
